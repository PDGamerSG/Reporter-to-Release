# Empty DATABASE_URL uses a local, single-process file ledger. Production requires Postgres.
DATABASE_URL=
APP_URL=http://localhost:3000
# Generate unique random secrets (at least 32 characters).
SESSION_SECRET=
ADMIN_TOKEN=
WORKER_TOKEN=
ENGINEERING_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_REPOSITORY=PDGamerSG/Reporter-to-Release
OWNER_GITHUB_LOGINS=PDGamerSG
CODEOWNER_GITHUB_LOGINS=PDGamerSG
# AI triage through the Meta Model API. Empty disables triage; reports still work.
MODEL_API_KEY=
# Hard cap on total model spend, enforced before each call.
LLM_BUDGET_USD=5
LLM_HOURLY_LIMIT=60
LLM_CLIENT_HOURLY_LIMIT=10
# Switch worker configuration. Do not expose these to the browser.
SWITCH_URL=http://localhost:8100
SWITCH_AGENT_ID=
SWITCH_API_KEY=
SWITCH_PUBLIC_ROOM=
SWITCH_ENGINEERING_ROOM=
SWITCH_ENGINEERING_AGENT_IDS=
SWITCH_MANAGER_NAME=vulcan-manager
WORKER_STATE_PATH=.data/worker.sqlite
# AWS engineering service uses the existing server-only Meta key by default.
ENGINEERING_MODEL_PROVIDER=meta
ENGINEERING_META_MODEL=muse-spark-1.3
# Optional native Bedrock adapter; requires an available account token quota.
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=qwen.qwen3-coder-30b-a3b-v1:0
ENGINEERING_DAILY_MODEL_CALLS=20
# Telegram reporter updates. The bot token belongs only on the AWS worker.
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=

# Report screenshots. The app assumes the role through Vercel OIDC, so no AWS key is stored.
SCREENSHOT_BUCKET=
SCREENSHOT_ROLE_ARN=
SCREENSHOT_REGION=ap-southeast-2
SCREENSHOT_HOURLY_LIMIT=60

# Slack tokens belong in Switch Console when that bridge is added.
