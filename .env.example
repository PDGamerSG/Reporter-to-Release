SWITCH_URL=http://localhost:8100
SWITCH_AGENT_ID=
SWITCH_API_KEY=
SWITCH_PUBLIC_ROOM=
SWITCH_ENGINEERING_ROOM=
SWITCH_REPORTER_ID_MAP=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHAT_ID=
